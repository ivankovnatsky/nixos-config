# Global settingscaddy
{
	# Log configuration
	log {
		output file @logPathPrefix@/caddy/caddy.log {
			roll_size 10MB
			roll_keep 10
			roll_keep_for 48h
		}
		format json
		level INFO
	}

	# Configure storage location explicitly
	storage file_system {
		root /var/lib/caddy
	}

	# Configure ACME for external domains
	email @letsEncryptEmail@

	# Default ACME configuration - use cloudflare DNS challenge globally
	acme_dns cloudflare @cloudflareApiToken@
}

# Single wildcard certificate for all subdomains
# Use *.externalDomain to request a wildcard certificate
*.@externalDomain@ {
	bind @bindAddress@

	# Enable proper TLS with Let's Encrypt using DNS challenge for wildcard cert
	# https://caddyserver.com/docs/automatic-https#wildcard-certificates
	# https://caddy.community/t/how-to-use-dns-provider-modules-in-caddy-2/8148
	tls {
		dns cloudflare @cloudflareApiToken@
		# Use external DNS resolvers for ACME challenges
		# https://caddy.community/t/could-not-determine-zone-for-domain/18720/7
		resolvers 1.1.1.1 8.8.8.8
	}

	@lidarr host lidarr.@externalDomain@
	reverse_proxy @lidarr @a3Ip@:8686 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	@prowlarr host prowlarr.@externalDomain@
	reverse_proxy @prowlarr @a3Ip@:9696 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	@radarr host radarr.@externalDomain@
	reverse_proxy @radarr @a3Ip@:7878 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	@sonarr host sonarr.@externalDomain@
	reverse_proxy @sonarr @a3Ip@:8989 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	@transmission host transmission.@externalDomain@
	reverse_proxy @transmission @a3Ip@:9091 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	# Beszel monitoring hub
	@beszel host beszel.@externalDomain@
	reverse_proxy @beszel @a3Ip@:8090 {
		# Route to Beszel Hub on a3
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	# Uptime Kuma synthetic monitoring
	@kuma host kuma.@externalDomain@
	reverse_proxy @kuma @a3Ip@:3001

	@syncthing host syncthing.@externalDomain@
	reverse_proxy @syncthing @machineIp@:8384

	# Miniserve on a3
	@miniserve host miniserve.@externalDomain@
	reverse_proxy @miniserve @a3Ip@:8080 {
		# Headers for proper operation
		header_up X-Real-IP {remote_host}
		header_up Host {host}
		# Increase timeouts and buffer sizes for large directories and files
		transport http {
			keepalive 30s
			response_header_timeout 30s
		}
	}

	@podservice host podservice.@externalDomain@
	reverse_proxy @podservice @a3Ip@:8083 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	@navidrome host navidrome.@externalDomain@
	reverse_proxy @navidrome @a3Ip@:4533 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
		# Streaming support
		transport http {
			keepalive 12h
			keepalive_idle_conns 100
		}
	}

	@forgejo host forgejo.@externalDomain@
	reverse_proxy @forgejo @a3Ip@:3000 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
		transport http {
			keepalive 30s
		}
	}

	@openclaw host openclaw.@externalDomain@
	reverse_proxy @openclaw @a3Ip@:18789 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}

	@immich host immich.@externalDomain@
	reverse_proxy @immich @a3Ip@:2283 {
		header_up X-Real-IP {remote_host}
		header_up Host {host}
		# Mobile sync and video uploads need generous timeouts + body size.
		transport http {
			keepalive 12h
			keepalive_idle_conns 100
			response_header_timeout 300s
		}
	}

	# Logging for ACME and DNS services
	log {
		output file @logPathPrefix@/caddy/acme-sync.log {
			roll_size 10MB
			roll_keep 5
		}
		output file @logPathPrefix@/caddy/dns.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
